# Copy to .env.local and fill in values. See README and docs/README.md.

# --- App URL (used when showing the course share link) ---
NEXT_PUBLIC_HOST_NAME=http://localhost:3000

# --- Clerk (auth; required for sign-in and /dashboard) ---
# From https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Neon Postgres (Drizzle) ---
# Connection string from https://console.neon.tech (use the pooled "serverless" / HTTP-friendly URL)
NEXT_PUBLIC_NEON_DB_CONNECTION=

# --- Google AI (course generation) ---
NEXT_PUBLIC_GEMINI_API_KEY=

# --- YouTube Data API (video search in course flow) ---
NEXT_PUBLIC_YOUTUBE_API_KEY=

# --- Firebase (Storage; only apiKey is read from env — rest is in configs/firebaseConfig.jsx) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
